# jitsi-files configuration. Copy to .env (gitignored) and adjust.
# Bun loads .env automatically. Never commit .env or keys.

# --- Server ---
HOST=127.0.0.1
PORT=8070
# Public origin clients use to reach this service (used to build local download URLs).
PUBLIC_BASE_URL=http://localhost:8070

# --- Auth: Prosody short-lived JWTs (mod_short_lived_token, RS256) ---
# Paste the RSA PUBLIC key (SPKI PEM) matching Prosody's short_lived_token key_path private key.
# Multiline values work in .env with double quotes. Alternatively set JWT_PUBLIC_KEY_PATH.
JWT_PUBLIC_KEY=""
JWT_PUBLIC_KEY_PATH=""
# Must match the Prosody short_lived_token block (issuer + accepted_audiences entry).
JWT_ISSUER=file-sharing
JWT_AUDIENCE=file-sharing
# DANGER: DEV_NO_AUTH=1 skips Bearer verification entirely. Local testing only, never production.
DEV_NO_AUTH=0
# Optional moderator-only gate (stub, default off = all participants may upload/delete).
REQUIRE_MODERATOR=0

# --- Storage: local (default) or s3 ---
STORAGE_DRIVER=local
LOCAL_DIR=./data/files
SQLITE_PATH=./data/jitsi-files.sqlite
# Secret signing local download URLs. Generate: openssl rand -hex 32. Empty = ephemeral (links die on restart).
DOWNLOAD_SECRET=
# How long local download URLs stay valid.
DOWNLOAD_URL_TTL_SECONDS=900

# --- S3-compatible object storage (Backblaze B2 / Cloudflare R2 / MinIO) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Path-style URLs (required for MinIO, works for B2/R2 too). Set false for virtual-hosted style.
S3_FORCE_PATH_STYLE=true
S3_PREFIX=jitsi-files/
# How long S3 presigned download URLs stay valid (upstream single-file default is 3h = 10800).
PRESIGNED_URL_TTL_SECONDS=10800

# --- Limits ---
# Server-side upload cap in megabytes. Applies to every upload, whatever the client allows.
MAX_FILE_SIZE_MB=10

# --- Lifecycle: files disappear when the meeting ends, like chat messages ---
# Fallback expiry when the room-destroyed hook never fires (hours).
FILE_TTL_HOURS=24
# How often the sweeper deletes expired blobs + index rows (minutes).
SWEEP_INTERVAL_MINUTES=15
# Shared secret for DELETE /sessions/:sessionId (Prosody room-destroyed hook). Generate: openssl rand -hex 32.
INTERNAL_PURGE_TOKEN=

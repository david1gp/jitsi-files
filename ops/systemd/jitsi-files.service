[Unit]
Description=Jitsi file-sharing backend (jitsi-files)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/adaptive/jitsi-files
EnvironmentFile=%h/.config/jitsi-files/jitsi-files.env
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8070
ExecStart=/usr/bin/env bun dist/server.js
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
